*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Segoe UI;
}

body{
display:flex;
background:#eef2f7;
}

.sidebar{

width:240px;
height:100vh;
background:#0d6efd;
padding:20px;
position:fixed;

}

.sidebar h2{

color:white;
margin-bottom:40px;

}

.sidebar ul{

list-style:none;

}

.sidebar li{

margin:20px 0;

}

.sidebar a{

color:white;
text-decoration:none;
font-size:18px;

}

.sidebar a:hover{

padding-left:10px;
transition:.3s;

}

.main{

margin-left:260px;
padding:30px;
width:100%;

}

.cards{

display:flex;
gap:25px;
margin:30px 0;

}

.card{

flex:1;
background:white;
padding:25px;
border-radius:15px;
box-shadow:0 8px 18px rgba(0,0,0,.15);
transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

.card h1{

color:#0d6efd;
margin-top:15px;

}

table{

width:100%;
background:white;
border-collapse:collapse;
box-shadow:0 8px 18px rgba(0,0,0,.15);

}

table th{

background:#0d6efd;
color:white;
padding:15px;

}

table td{

padding:15px;
text-align:center;
border-bottom:1px solid #ddd;

}

tr:hover{

background:#f4f4f4;

}

.chart-card{
    margin:30px 0;
    background:#fff;
    padding:25px;
    border-radius:15px;
    box-shadow:0 8px 18px rgba(0,0,0,.15);
}
